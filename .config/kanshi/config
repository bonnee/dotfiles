  output 'Dell Inc. DELL S2721DGF J129T83' mode 2560x1440@165.080 position 1920,0
}

# Desk + phone-dash (sway's HEADLESS-1, see sway/arch23/30_phone_dash.conf).
# kanshi only matches a profile listing exactly the connected outputs, so with
# HEADLESS-1 present the 2-output desk profiles above never match.
# The phone output is listed only so this profile matches; its mode, position
# and scale live in sway/arch23/30_phone_dash.conf (kanshi doesn't re-apply on
# a sway reload, so sway must own them).
profile desk_phone {
  output 'LG Electronics M2362D 0x01010101' mode 1920x1080@60.000 position 0,180 scale 1
  output 'Dell Inc. DELL S2721DGF J129T83' mode 2560x1440@165.080 position 1920,0 scale 1
  output HEADLESS-1
}

