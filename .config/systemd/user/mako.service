[Unit]
Description=Lightweight Wayland notification daemon
Documentation=man:mako(1)
PartOf=sway-session.target
# graphical-session.target is ordered before the XDG autostart target, so
# finishing mako first guarantees the notification daemon owns the bus before
# apps like blueman-applet start and try to notify.
# Deliberately no "After=sway-session.target": together with Before=graphical-
# session.target it forms a stop-ordering cycle (sway-session -> mako ->
# graphical -> sway-session) that blocks the session from shutting down.
Before=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecCondition=/bin/sh -c '[ -n "$WAYLAND_DISPLAY" ]'
ExecStart=/usr/bin/mako
ExecReload=/usr/bin/makoctl reload
ExecStop=/bin/kill -2 $MAINPID
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=sway-session.target
