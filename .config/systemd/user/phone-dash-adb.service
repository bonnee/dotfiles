[Unit]
Description=phone-dash: keep the phone connected and streaming (tethering, adb, Moonlight)
PartOf=sway-session.target
# Ordered after Sunshine so Moonlight, launched on (re)connect, finds it.
After=graphical-session.target sway-session.target phone-dash-sunshine.service

[Service]
EnvironmentFile=%h/.config/phone-dash/env
ExecStart=%h/.local/bin/phone-dash-adb
Restart=always
RestartSec=5

[Install]
WantedBy=sway-session.target
