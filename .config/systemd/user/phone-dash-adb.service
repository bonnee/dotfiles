[Unit]
Description=phone-dash: keep the phone connected (USB tethering / adb tunnel, AVNC)
PartOf=sway-session.target
# Ordered after wayvnc so AVNC, launched on (re)connect, finds a server.
After=graphical-session.target sway-session.target phone-dash-vnc.service

[Service]
EnvironmentFile=%h/.config/phone-dash/env
ExecStart=%h/.local/bin/phone-dash-adb
Restart=always
RestartSec=5

[Install]
WantedBy=sway-session.target
