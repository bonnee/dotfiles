[Unit]
Description=phone-dash: Home Assistant kiosk (phone background)
PartOf=sway-session.target
After=graphical-session.target sway-session.target

[Service]
# Separate Firefox profile (~/.local/share/hass-dash/firefox: user.js, chrome/
# userChrome.css hide the browser UI). --name sets the Wayland app_id that
# phone-dash-daemon places on the phone. Firefox (unlike Chromium) takes input
# from the second "phone" seat. Restart=always: comes back if closed/crashed.
# To close it on purpose: systemctl --user stop phone-dash-hass
ExecStart=/usr/bin/firefox-developer-edition --new-instance --profile %h/.local/share/hass-dash/firefox --name hass-dash-ff https://hass.pgl.bonnee.me/
Restart=always
RestartSec=2

[Install]
WantedBy=sway-session.target
