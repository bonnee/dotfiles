[Unit]
Description=phone-dash: phone touchscreen -> virtual touchscreen on HEADLESS-1
PartOf=sway-session.target
After=graphical-session.target sway-session.target

[Service]
EnvironmentFile=%h/.config/phone-dash/env
ExecStart=%h/.local/bin/phone-dash-touch
# Exits when the adb stream ends (phone unplugged, adb restarted): retry.
Restart=always
RestartSec=2

[Install]
WantedBy=sway-session.target
