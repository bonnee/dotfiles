[Unit]
Description=Idle manager for Wayland
Documentation=man:swayidle(1)
PartOf=sway-session.target

[Service]
Type=simple
KillMode=process
Environment=LOCK="%h/.local/bin/lockw.sh"
ExecStart=/usr/bin/swayidle -w lock '${LOCK}' timeout 1 'true' resume 'swaymsg "output * dpms on"' timeout 300 'can_dpms.sh || { swaymsg "output * dpms off"; phone-dash-power off; }' resume 'swaymsg "output * dpms on"; phone-dash-power on' timeout 330 '${LOCK}' timeout 600 'swayidle_tick.sh' before-sleep 'phone-dash-power off; ${LOCK}' after-resume 'sleep 1; swaymsg "output * dpms on"; swaymsg "output * power on"; phone-dash-power on'

# kill -9 (not -2) on stop/restart: the periodic restart that swayidle_tick.sh
# triggers must not run stale pending `resume` commands (which would switch
# the display back on every 10-min cycle while media plays).
ExecStop=/bin/sh -c 'kill -9 "$$MAINPID" 2>/dev/null || true'
Restart=on-failure
RestartSec=1
TimeoutStopSec=30

[Install]
WantedBy=sway-session.target
