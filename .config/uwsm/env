# Graphical session environment, sourced by uwsm for the sway session only.
# Shell-visible vars (PATH, tool homes, HISTFILE, ...) stay in ~/.zprofile /
# ~/.config/env/. XDG_SESSION_TYPE and XDG_CURRENT_DESKTOP are set by uwsm
# itself (its sway plugin appends ":wlroots").
#
# Nothing machine-specific belongs in this file: uwsm sources env.d/90-host.sh
# after it, and that fragment applies ~/.config/env/<hostname>/ (the same host
# layer the login shells use), so per-machine values win. Examples: GDK_SCALE,
# QT_FONT_DPI, RUSTICL_ENABLE.

# Client side decorations
export GTK_CSD=0

# Toolkits: use Wayland natively
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export CLUTTER_BACKEND=wayland
export BEMENU_BACKEND=wayland

# Firefox
export MOZ_ENABLE_WAYLAND=1
export MOZ_DBUS_REMOTE=1

# Java AWT window management under a non-reparenting WM
export _JAVA_AWT_WM_NONREPARENTING=1

# Scaling, DPI and OpenCL (rusticl) values are per machine and live in
# ~/.config/env/<hostname>/ (applied by env.d/90-host.sh after this file).

# pywal/wpg generated colors for the session: BEMENU_OPTS theme, FZF_DEFAULT_OPTS,
# LS_COLORS, ... (regenerated by wpg on wallpaper change; picked up next login).
[ -r "$HOME/.cache/wal/colors.sh" ] && . "$HOME/.cache/wal/colors.sh"
