#!/bin/sh
# dropwin - keep a drop-down (scratchpad) terminal alive for an app_id.
#
#   dropwin <app_id> [command ...]
#
# Spawns the terminal with the window's app_id set to <app_id>, parks the window
# in the scratchpad the moment sway reports it, and respawns the terminal 0.5s
# after it exits. Nothing polls for the window: placement is driven by sway's
# window events and the respawn by waiting for the child process.
#
# The window is hidden first and resized/centred while it is in the scratchpad.
# Applying the size while the window is still being mapped is racy - sway then
# computes it against the tiling container and the drop-down ends up at
# ~1928x1052 instead of 1820x900. Doing it with `for_window` rules instead is
# ruled out by the re-fire behaviour described below.
#
# Why no `for_window` rule for these windows: sway re-runs for_window criteria on
# every window title/app_id change, and the per-view guard is lost after any
# `reload` (`swaymsg reload` is issued silently by pywal/wpgtk on every palette
# change) and after an unmap/remap. A geometry rule then fires again on the
# hidden window and pulls it back onto the workspace - "the drop term does not
# stay in the scratchpad after a reload".

set -u

app_id=${1:-}
[ -n "$app_id" ] || { echo "usage: $(basename "$0") <app_id> [command ...]" >&2; exit 2; }
shift

term=${DROPWIN_TERM:-footclient}
width=${DROPWIN_WIDTH:-1820}
height=${DROPWIN_HEIGHT:-900}

: "${SWAYSOCK:?SWAYSOCK is not set - run this inside a sway session}"

# Only one supervisor per app_id may run: two of them race to spawn and respawn
# the window (this happens when a drop-down is restarted by hand while an old
# copy is still around).
lock="${XDG_RUNTIME_DIR:-/tmp}/dropwin-$app_id.lock"
exec 9>"$lock" || exit 1
flock -n 9 || exit 0

spawn() {
	case "${term##*/}" in
	foot|footclient)
		# footclient takes the command as trailing arguments. Its `-e` exists
		# only for xterm compatibility and swallows the command, which silently
		# started a plain shell instead of `qalc`/`nvim`.
		[ "${1:-}" = "-e" ] && shift
		"$term" --app-id "$app_id" -w "${width}x${height}" "$@"
		;;
	*)               "$term" --class   "$app_id" "$@" ;;
	esac
}

existing() {
	swaymsg -t get_tree -r |
		jq -r --arg app "$app_id" 'first(.. | objects | select(.app_id? == $app) | .id) // empty'
}

place() {
	# Step 1: make it invisible and hide it in one command list. The window maps
	# tiled and is on screen for a frame or two before it can be hidden, and it
	# would be seen at the tiled size - the "flash" that made the drop-down look
	# broken. One IPC round trip instead of two keeps that window short.
	swaymsg -q "[app_id=\"$app_id\"] opacity 0, floating enable, mark $app_id, move to scratchpad"

	# Step 2: let the tiling helper settle. It reacts to the map event
	# asynchronously and resizes the window after it has been hidden, which is
	# what left the drop-down at the workspace size (~1920x1048).
	sleep 0.25

	# Step 3: size and centre while the window sits in the scratchpad. A single
	# attempt is not reliable: if the window is still being mapped, sway computes
	# the size against the tiling container. Repeat until the stored geometry is
	# within a character cell of the request (foot snaps to whole cells).
	i=0
	while [ $i -lt 20 ]; do
		swaymsg -q "[app_id=\"$app_id\"] resize set $width $height, move position center"
		sleep 0.05
		settled "$(geometry)" && break
		i=$((i + 1))
	done

	# Step 4: visible again, still hidden in the scratchpad.
	swaymsg -q "[app_id=\"$app_id\"] opacity 1"
}

geometry() {
	swaymsg -t get_tree -r |
		jq -r --arg app "$app_id" \
			'first(.. | objects | select(.app_id? == $app) | "\(.rect.width)x\(.rect.height)") // empty'
}

# true when WxH is within one character cell of the requested size
settled() {
	w=${1%x*}
	h=${1#*x}
	[ -n "$w" ] && [ -n "$h" ] &&
		[ "$w" -ge $((width - 40)) ] && [ "$w" -le $((width + 40)) ] &&
		[ "$h" -ge $((height - 40)) ] && [ "$h" -le $((height + 40)) ]
}

# Park every new window of this app_id in the scratchpad. Event driven, and
# started before the first spawn so the `new` event cannot be missed (swaymsg
# needs a moment to subscribe, hence the sleep below).
swaymsg -t subscribe -m '["window"]' |
	jq --unbuffered -r --arg app "$app_id" \
		'select(.container.app_id? == $app and .change == "new") | .change' |
	while read -r _; do
		place
	done &

sleep 0.3

while [ -S "$SWAYSOCK" ]; do
	# A window with this app_id is already up (started before this script, or
	# before a restart): wait for it instead of spawning a second one.
	while [ -n "$(existing)" ]; do sleep 1; done

	# pass the script's arguments: inside spawn() "$@" is the function's own
	# positional list, so a bare `spawn` would drop `-e nvim` / `-e qalc`
	spawn "$@"
	sleep 0.5
done
