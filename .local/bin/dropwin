#!/bin/sh
# dropwin - keep a drop-down (scratchpad) terminal alive for an app_id.
#
#   dropwin <app_id> [command ...]
#
# Spawns the terminal with the window's app_id set to <app_id> and respawns it
# 0.5 s after it exits. Nothing here places the window: the per-app_id
# `for_window` rule in sway/config.d/50_rules.conf floats it, sizes it, marks it
# and moves it into the scratchpad at map time, before sway draws it - that is
# what keeps the drop-down from flashing in the workspace.
#
# The rule's criteria include the transient start-up title set with `-T`
# ("boot-<pid>-<app_id>"), so it stops matching as soon as the shell sets its
# own title. A rule that matches for the window's whole life would fire again on
# every title change after a `reload` (which wpgtk/pywal trigger on palette
# changes) and pull a visible drop-down back into the scratchpad.

set -u

app_id=${1:-}
[ -n "$app_id" ] || { echo "usage: $(basename "$0") <app_id> [command ...]" >&2; exit 2; }
shift

term=${DROPWIN_TERM:-footclient}
width=${DROPWIN_WIDTH:-1820}
height=${DROPWIN_HEIGHT:-900}

: "${SWAYSOCK:?SWAYSOCK is not set - run this inside a sway session}"

# Only one supervisor per app_id may run: two of them race to spawn and respawn
# the window (this happens when a drop-down is restarted by hand while an old
# copy is still around).
lock="${XDG_RUNTIME_DIR:-/tmp}/dropwin-$app_id.lock"
exec 9>"$lock" || exit 1
flock -n 9 || exit 0

spawn() {
	case "${term##*/}" in
	foot|footclient)
		# footclient takes the command as trailing arguments; its `-e` exists
		# only for xterm compatibility and swallows the command.
		[ "${1:-}" = "-e" ] && shift
		[ $# -gt 0 ] || set -- "${SHELL:-/bin/sh}"

		# -T sets the start-up title the for_window rule matches. The wrapper
		# then sets a real title before exec'ing the command, so the criteria
		# stop matching as soon as the window exists: a rule that keeps matching
		# (a program that never sets a title, like qalc) would fire again on
		# later title changes and could pull the window out of the scratchpad.
		"$term" --app-id "$app_id" -T "boot-$$" -w "${width}x${height}" \
			sh -c 'printf "\033]2;%s\007" "$1"; shift; exec "$@"' \
			dropwin "$app_id" "$@"
		;;
	*) "$term" --class "$app_id" "$@" ;;
	esac
}

existing() {
	swaymsg -t get_tree -r |
		jq -r --arg app "$app_id" 'first(.. | objects | select(.app_id? == $app) | .id) // empty'
}

while [ -S "$SWAYSOCK" ]; do
	# A window with this app_id is already up (started before this script, or
	# before a restart): wait for it instead of spawning a second one.
	while [ -n "$(existing)" ]; do sleep 1; done

	spawn "$@"
	sleep 0.5
done
