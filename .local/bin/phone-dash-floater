#!/usr/bin/env python3
"""Keep the Home Assistant kiosk as the tiled "background" of the phone-dash
workspace and make every other window that lands there float on top of it.

Rules:
  * The HA kiosk (app_id hass-dash-ff, Firefox profile) is kept tiled, borderless.
  * Any other window that *arrives* on DASH_WS (opened there, `move to
    workspace`, dragged across outputs, ...) is floated, sized to 60%x70% of the
    workspace and centred -- once per arrival. Afterwards it is left alone, so
    the user can resize/move/tile it freely. Leaving the workspace and coming
    back counts as a new arrival.
  * Windows that are already floating when they arrive keep their geometry,
    unless they are bigger than the workspace, in which case they are shrunk.
  * Scratchpad windows (dropterm & co.) are never touched.
  * Fullscreen is left to sway: a floating window that goes fullscreen covers
    the output and returns to its floating geometry afterwards.
  * On IPC disconnect we reconnect (sway reload keeps the socket); if sway is
    gone for good we exit non-zero.
"""
import re
import sys
import threading
import time

import i3ipc

DASH_WS = "11:dash"
HASS_APP_ID = re.compile(r"^hass-dash-ff$")
W_FRAC, H_FRAC = 0.6, 0.7
# Freshly mapped clients often commit their own preferred size right after we
# resize them, so the geometry is applied a second time shortly afterwards.
SETTLE_DELAY = 0.4
POLL_INTERVAL = 1.5  # fallback pass for moves sway sends no event for
RECONNECT_GIVE_UP = 60  # seconds without a working connection before exiting

# ids of windows we have already handled during their current stay on DASH_WS
known: set[int] = set()
lock = threading.Lock()  # reconcile runs from the event loop and the poller


def log(*a):
    print("phone-dash-floater:", *a, file=sys.stderr, flush=True)


def is_hass(con):
    return bool(con.app_id and HASS_APP_ID.match(con.app_id))


def is_floating(con):
    return con.floating in ("auto_on", "user_on") or con.type == "floating_con"


def is_view(con):
    return con.pid is not None or con.window is not None


def views(con):
    """The application windows in con (con itself if it is one)."""
    if is_view(con):
        return [con]
    return [c for c in con.descendants() if is_view(c)]


def arrive(con, ws):
    """con is an application window currently on DASH_WS."""
    if is_hass(con):
        if is_floating(con):
            con.command("floating disable")
        if con.border != "none":
            con.command("border none")
        return
    if "phone" in (con.marks or []):
        # Sent here by phone-dash-send (fullscreen slot): not ours to manage.
        return
    if con.id in known:
        return
    if con.fullscreen_mode:
        # Arrived fullscreen (e.g. a video player started with --fs): leave it
        # alone and handle it once it leaves fullscreen.
        return
    known.add(con.id)
    if getattr(con, "scratchpad_state", "none") not in (None, "none"):
        return
    if not is_floating(con):
        place(con, ws)
        log(f"floated {con.app_id or con.window_class} ({con.id})")
    elif con.rect.width > ws.rect.width or con.rect.height > ws.rect.height:
        place(con, ws)
        log(f"shrunk oversized {con.app_id or con.window_class} ({con.id})")


def place(con, ws):
    w, h = int(ws.rect.width * W_FRAC), int(ws.rect.height * H_FRAC)
    cmd = f"resize set {w} px {h} px, move position center"
    if not is_floating(con):
        cmd = "floating enable, " + cmd
    con.command(cmd)

    def again():
        try:
            c = con._conn.get_tree().find_by_id(con.id)
            cws = c and c.workspace()
            if c and cws and cws.name == DASH_WS and is_floating(c) and not c.fullscreen_mode:
                c.command(cmd.replace("floating enable, ", ""))
        except Exception as ex:
            log(f"settle failed: {ex!r}")

    t = threading.Timer(SETTLE_DELAY, again)
    t.daemon = True
    t.start()


def reconcile(ipc):
    """Bring DASH_WS in line with the rules.

    Run on every window/workspace event rather than only on new/move: sway
    emits no window::move when a *floating* window changes output/workspace
    (mouse drag across outputs, `move position`, `move absolute position`),
    so a full pass over the workspace is the only reliable way to notice --
    and since such a move may emit no event at all, a poller also calls this."""
    with lock:
        _reconcile(ipc)


def _reconcile(ipc):
    on_dash = set()
    for ws in ipc.get_tree().workspaces():
        if ws.name != DASH_WS:
            continue
        for v in views(ws):
            on_dash.add(v.id)
            arrive(v, ws)
    # forget windows that left (or closed) so a later return counts as new
    known.intersection_update(on_dash)


def on_event(ipc, e):
    try:
        reconcile(ipc)
    except Exception as ex:  # never let one bad event kill the loop
        log(f"error handling {getattr(e, 'change', e)}: {ex!r}")


def run_once():
    ipc = i3ipc.Connection()
    ipc.on(i3ipc.Event.WINDOW, on_event)
    ipc.on(i3ipc.Event.WORKSPACE, on_event)
    with lock:
        known.clear()
    reconcile(ipc)
    log("connected")
    stop = threading.Event()

    def poll():
        while not stop.wait(POLL_INTERVAL):
            try:
                reconcile(ipc)
            except Exception as ex:
                log(f"poll failed: {ex!r}")
                return  # main() will notice the dead socket too

    threading.Thread(target=poll, daemon=True).start()
    try:
        ipc.main()  # returns (or raises) when the connection drops
    finally:
        stop.set()


def main():
    last_ok = time.monotonic()
    delay = 0.5
    while True:
        started = time.monotonic()
        try:
            run_once()
            log("IPC connection closed")
        except Exception as ex:
            log(f"IPC error: {ex!r}")
        now = time.monotonic()
        if now - started > 5:  # we had a working session; reset backoff
            last_ok, delay = now, 0.5
        if now - last_ok > RECONNECT_GIVE_UP:
            log("sway unreachable, giving up")
            sys.exit(1)
        time.sleep(delay)
        delay = min(delay * 2, 5)


if __name__ == "__main__":
    main()
