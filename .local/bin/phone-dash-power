#!/bin/sh
# Turn the phone-dash phone's screen off/on over adb (USB).
#   off: system going to sleep (phone-dash-sleep.service), monitors powered off
#   on:  system resumed, monitors powered on again (phone-dash-daemon)
# Uses the power keys, which work even with stay_on_while_plugged_in set.
[ -n "$ANDROID_SERIAL" ] || . "$HOME/.config/phone-dash/env"
export ANDROID_SERIAL

case "$1" in
    off) tries=5 key=KEYCODE_SLEEP ;;    # before suspend: be quick
    on)  tries=60 key=KEYCODE_WAKEUP ;;  # after resume adb can take 15+ s
    *)   echo "usage: $0 on|off" >&2; exit 2 ;;
esac
i=0
while [ $i -lt $tries ]; do
    adb get-state >/dev/null 2>&1 && exec adb shell input keyevent "$key"
    sleep 1; i=$((i + 1))
done
exit 1
