#!/bin/sh
# Run by sway on every (re)load (exec_always). A sway reload re-applies seat
# config, which leaves wayvnc's virtual pointer/keyboard on the "phone" seat
# stale (clients stop getting its input). Restart wayvnc for fresh devices and
# reconnect AVNC. try-restart: no-op at login, before the service is up.
SERIAL="${PHONE_DASH_SERIAL:-e90acbb2}"
systemctl --user is-active -q phone-dash-vnc.service || exit 0
sleep 1
systemctl --user try-restart phone-dash-vnc.service
sleep 2
adb -s "$SERIAL" get-state >/dev/null 2>&1 || exit 0
adb -s "$SERIAL" shell "am start --activity-clear-task -a android.intent.action.VIEW -d 'vnc://127.0.0.1:5900' com.gaurav.avnc" >/dev/null
