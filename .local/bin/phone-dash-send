#!/usr/bin/env python3
"""Single-slot "scratchpad" for the phone screen ($mod+p / $mod+Shift+p).

  phone-dash-send toggle   focused window -> phone. If it already is the
                           phone window, send it back. A window previously on
                           the phone is sent back first.
  phone-dash-send return   send the phone window back, wherever focus is.

On the phone the window is tiled and replaces the HA dashboard (both done by
phone-dash-daemon). Sending back restores where it came from: its workspace
and, if it was floating, floating with its old size. That origin is kept in
$XDG_RUNTIME_DIR/phone-dash-slot.json; the window carries the mark "phone".
"""
import json
import os
import sys

import i3ipc

DASH_WS = "11:dash"
MARK = "phone"
HASS_APP_ID = "hass-dash-ff"
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "phone-dash-slot.json")

ipc = i3ipc.Connection()


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(d):
    with open(STATE, "w") as f:
        json.dump(d, f)


def back_cmds(con, origin):
    """Commands that return con to where it came from."""
    ws = origin.get("workspace")
    if not ws or ws.startswith(DASH_WS):
        # Unknown origin: the focused workspace on a real monitor.
        ws = next(w.name for w in ipc.get_workspaces()
                  if w.visible and not w.name.startswith(DASH_WS))
    c = f"[con_id={con.id}]"
    cmds = [f"{c} unmark {MARK}", f"{c} move container to workspace {ws}"]
    if origin.get("floating"):
        cmds.append(f"{c} floating enable")
        if origin.get("w") and origin.get("h"):
            cmds.append(f"{c} resize set {origin['w']} px {origin['h']} px")
        cmds.append(f"{c} move position center")
    return cmds


def send_cmds(con):
    """Commands that put con on the phone (tiling is the daemon's job)."""
    c = f"[con_id={con.id}]"
    return [f"{c} mark --add {MARK}", f"{c} move container to workspace {DASH_WS}"]


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    tree = ipc.get_tree()
    state = load()
    alive = {str(c.id) for c in tree.leaves()}
    state = {k: v for k, v in state.items() if k in alive}   # forget closed windows
    marked = tree.find_marked(f"^{MARK}$")
    current = marked[0] if marked else None
    focused = tree.find_focused()
    sendable = (action == "toggle" and focused is not None
                and focused.type in ("con", "floating_con")
                and (focused.app_id or focused.window_class)
                and focused.app_id != HASS_APP_ID
                and not (current and current.id == focused.id))

    cmds = []
    if current:
        cmds += back_cmds(current, state.pop(str(current.id), {}))
    if sendable:
        ws = focused.workspace()
        state[str(focused.id)] = {
            "workspace": ws.name if ws else None,
            "floating": focused.floating in ("auto_on", "user_on"),
            "w": focused.rect.width, "h": focused.rect.height}
        cmds += send_cmds(focused)
    save(state)
    if cmds:
        # One IPC message: a swap never shows the dashboard in between.
        ipc.command("; ".join(cmds))


if __name__ == "__main__":
    main()
