#!/bin/sh
# Print the address wayvnc should listen on for the phone:
# the PC's IPv4 on the phone's USB-tethering (RNDIS) link if it is up,
# otherwise 127.0.0.1 (reached from the phone via the adb reverse tunnel).
for n in /sys/class/net/*; do
    drv=$(basename "$(readlink -f "$n/device/driver" 2>/dev/null)")
    [ "$drv" = rndis_host ] || continue
    ip=$(ip -4 -o addr show dev "$(basename "$n")" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    [ -n "$ip" ] && { echo "$ip"; exit 0; }
done
echo 127.0.0.1
