#!/bin/sh
# spotify-drop - launch Spotify as a scratchpad drop-down (mark "music").
#
# Used as the Exec= line of the Spotify desktop entry. The running instance
# is never restarted: if Spotify is already up, the URI is handed to it and
# its window is revealed; otherwise it is started and placed into the
# scratchpad by ~/.local/bin/swayplace.
#
# Launching Spotify another way still works: the for_window rule in
# sway/config.d/50_rules.conf marks the window "music" (floating), it just is
# not hidden automatically - that is what $mod+x (~/.local/bin/spotify-toggle)
# is for.

set -u

: "${SWAYSOCK:?SWAYSOCK is not set - run this inside a sway session}"

if swaymsg -t get_tree -r | jq -e '.. | objects | select(.app_id == "spotify")' >/dev/null; then
	spotify-toggle show
	exec /usr/bin/spotify "$@"
fi

/usr/bin/spotify "$@" &
pid=$!
swayplace spotify "$pid" 1600 900
wait "$pid"
