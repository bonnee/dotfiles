#!/bin/sh
# spotify-toggle - show/hide the Spotify window ($mod+x).
#
#   spotify-toggle [show]
#
# Hidden in the scratchpad -> show it.  On screen (or on another workspace)
# -> move it to the scratchpad.  "show" only ever reveals it, which is what
# ~/.local/bin/spotify-drop uses when handing a URI to a running instance.
#
# Replaces `bindsym $mod+x [con_mark="music"] scratchpad show`: that only
# worked while the window was in the scratchpad, which is no longer
# guaranteed now that Spotify is not put there by a for_window rule.

set -u

: "${SWAYSOCK:?SWAYSOCK is not set - run this inside a sway session}"

mode=${1:-toggle}

info=$(swaymsg -t get_tree -r |
	jq -r 'first(.. | objects | select(.app_id == "spotify")) | "\(.id) \(.scratchpad_state)"')

# Spotify is not running (or not mapped): nothing to do.
[ -n "$info" ] || exit 0
id=${info% *}
state=${info#* }

# scratchpad_state is "fresh" while the container is in the scratchpad
# ("none" for a normal floating/tiling window - see sway's ipc-json.c).
if [ "$state" != "none" ]; then
	swaymsg -q "[con_id=$id] scratchpad show"
elif [ "$mode" != "show" ]; then
	swaymsg -q "[con_id=$id] move to scratchpad"
fi
