#!/bin/sh
# swayplace - turn a freshly started window into a scratchpad drop-down.
#
#   swayplace <app_id> <pid> [width height]
#
# Waits until sway knows the window owned by <pid>, then applies, once:
#
#   floating enable, resize set <width> <height>, move position center,
#   mark <app_id>, move to scratchpad
#
# The resize has to happen while the window is still on-screen: sway skips
# resizes for scratchpad-hidden windows (view_autoconfigure returns early),
# so resizing after `move to scratchpad` never reaches the client.
#
# Used by ~/.local/bin/dropwin (drop-down terminals) and
# ~/.local/bin/spotify-drop, so that neither needs a for_window rule.
# for_window criteria are re-run on every window title change once their
# per-view guard is gone (i.e. after any reload or unmap/remap), which makes
# side effects such as `move to scratchpad` fire at random later moments.

set -u

app_id=${1:-}
pid=${2:-}
if [ -z "$app_id" ] || [ -z "$pid" ]; then
	echo "usage: $(basename "$0") <app_id> <pid> [width height]" >&2
	exit 2
fi
width=${3:-1820}
height=${4:-900}

: "${SWAYSOCK:?SWAYSOCK is not set - run this inside a sway session}"

i=0
while [ $i -lt 500 ]; do
	# Match the app_id first: dropwin keeps it unique, sway always sees it, and
	# a thin client such as footclient has no window pid at all (the
	# `foot --server` it talks to owns the toplevel and the pty). One IPC round
	# trip per poll keeps the window from being shown tiled for longer than a
	# frame - that flash is what made the drop-down look broken.
	if swaymsg -q "[app_id=\"$app_id\"] floating enable, resize set $width $height, move position center, mark $app_id, move to scratchpad"; then
		exit 0
	fi
	# Safety net for clients whose window does not carry the expected app_id.
	if [ $i -ge 50 ] &&
	   swaymsg -q "[pid=$pid] floating enable, resize set $width $height, move position center, mark $app_id, move to scratchpad"; then
		exit 0
	fi
	# Client is gone (e.g. footclient without a running foot --server): no
	# window will ever appear, so do not keep polling.
	kill -0 "$pid" 2>/dev/null || {
		echo "swayplace: pid $pid is gone (app_id $app_id)" >&2
		exit 1
	}
	sleep 0.005
	i=$((i + 1))
done

echo "swayplace: no window for pid $pid (app_id $app_id)" >&2
exit 1
